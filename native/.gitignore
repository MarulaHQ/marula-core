# Expo / Metro
.expo/
dist/
web-build/
*.orig.*

# Native build output (generated by `expo run:ios` / `expo prebuild`)
ios/
android/
native-artifacts/

# Local Expo module source lives under modules/*/ios and modules/*/android —
# not generated prebuild output, so un-ignore it.
!modules/**/ios/
!modules/**/android/

# Test and CI artifacts
artifacts/
coverage/

# Generated by expo start (per the SDK 57 template)
expo-env.d.ts

# OS / editor
.DS_Store
*.log
