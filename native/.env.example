# Local app configuration (Expo CLI auto-loads this file for `expo start`,
# `expo run:ios`, and the Xcode bundling phase).
#
# Copy to `.env` and point it at a running core-api. The E2E stack writes
# real URLs into e2e/.e2e-stack.env; scripts/e2e-stack.sh prints them.
#
# EXPO_PUBLIC_* values are inlined at bundle time. After changing them,
# rebuild (a Release build embeds the bundle); if a value looks stale,
# clear the Metro cache first.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=ws://localhost:8081/ws
# Dev-menu surfaces (airplane toggle, scan injector). Dev clients already
# have them; Release verification builds opt in with this.
EXPO_PUBLIC_ENABLE_DEV_TOOLS=1
