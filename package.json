{
  "name": "marula-core",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "theme:check": "node scripts/check-theme-packs.mjs",
    "docker:check": "node scripts/check-dockerfile-workspace.mjs --self-test && node scripts/check-dockerfile-workspace.mjs",
    "components:check": "node scripts/check-component-conformance.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "accept": "tsx scripts/acceptance.ts",
    "evidence:check": "node scripts/check-evidence-writes.mjs",
    "time:check": "node scripts/check-time-display.mjs",
    "alerts:check": "node scripts/check-alert-rules.mjs",
    "levers:check": "node scripts/generate-reliability-levers.mjs --check",
    "agents:check": "node scripts/check-agent-manifest.mjs",
    "rows:check": "node scripts/p47-row-effect-check.mjs --strict",
    "shortcuts:check": "tsx --tsconfig apps/web/tsconfig.json scripts/check-command-targets.ts",
    "hooks:check": "node scripts/check-hook-paths.mjs",
    "target:check": "python3 scripts/lane-target-guard.py check --all-profiles",
    "e2e:stack": "bash scripts/e2e-stack.sh",
    "e2e:build-web": "bash scripts/e2e-build-web.sh",
    "demo:smoke": "bash scripts/demo-smoke.sh",
    "e2e": "pnpm exec playwright test --config=e2e/playwright.config.ts && node e2e/flake-gate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.5.0"
  }
}
