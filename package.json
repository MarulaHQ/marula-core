{
  "name": "marula-core",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "theme:check": "node scripts/check-theme-packs.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "accept": "tsx scripts/acceptance.ts",
    "evidence:check": "node scripts/check-evidence-writes.mjs",
    "target:check": "python3 scripts/lane-target-guard.py check --all-profiles",
    "e2e:stack": "bash scripts/e2e-stack.sh",
    "e2e:build-web": "bash scripts/e2e-build-web.sh",
    "e2e": "pnpm exec playwright test --config=e2e/playwright.config.ts && node e2e/flake-gate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "playwright": "^1.63.0",
    "tsx": "^4.23.12",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
