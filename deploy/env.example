# The eight values the compose stack refuses to start without.
#
# `./install.sh` generates all of them and writes them into `marula.env` for
# you. This file is for the other path: someone running compose by hand, who
# wants the shape of the file and the reason for each line without launching an
# installer.
#
#   cp deploy/env.example marula.env
#   # replace every change-me below, or let scripts/gen-env.sh do it:
#   scripts/gen-env.sh marula.env
#   docker compose --env-file marula.env -f deploy/docker-compose.yml up -d
#
# Every value here is a secret. Do not commit the filled file.

# Signs every session token. Rotating it signs everyone out.
JWT_SECRET=change-me-32-bytes-hex

# Encrypts the values the application stores encrypted (connector credentials,
# webhook signing keys). Rotating it makes those values unreadable, so back it up
# with the database.
MARULA_SECRET_KEY=change-me-32-bytes-hex

# Authenticates service-to-service calls inside the stack.
MARULA_INTERNAL_TOKEN=change-me

# Authenticates the mail path between core-api and the email service.
EMAIL_INTERNAL_TOKEN=change-me

# The Postgres owner role. Applied by initdb on the first boot only: changing it
# here later does not change the password the volume was created with.
POSTGRES_PASSWORD=change-me-32-bytes-hex

# The application role, which is subject to row-level security. The API applies
# it to the role at startup.
MARULA_APP_PASSWORD=change-me-32-bytes-hex

# The object store's inter-node secret. Only used by the split shape.
GARAGE_RPC_SECRET=change-me-32-bytes-hex

# The error tracker's own encryption key.
GLITCHTIP_SECRET_KEY=change-me-32-bytes-hex
