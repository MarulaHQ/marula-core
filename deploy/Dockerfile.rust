// Meridian backend image builder.
//
// Purpose: one parameterized image for all Rust binaries (core-api,
// realtime, worker, meridian-cli). Build with --build-arg BIN=<name>.
// Non-purpose: no frontend build here; apps/web gets its own image when
// it lands.
//
// Build context is the repository root (workspace Cargo.toml lives there).
# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS build
ARG BIN=core-api
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release --bin ${BIN}

FROM debian:bookworm-slim
ARG BIN=core-api
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/${BIN} /usr/local/bin/${BIN}
# Shell form so ${BIN} resolves at build time per service.
ENTRYPOINT /usr/local/bin/${BIN}
CMD []
