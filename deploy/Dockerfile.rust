# Marula backend image builder.
#
# Purpose: one parameterized image for all Rust binaries (core-api,
# worker, marula-core-cli). Build with --build-arg BIN=<name>; every BIN value
# shares one builder stage that compiles all three binaries together.
# Non-purpose: no frontend build here; apps/web gets its own image when
# it lands.
#
# Build context is the repository root (workspace Cargo.toml lives there).
# syntax=docker/dockerfile:1

# Exact-version base, digest-pinned (p38 policy: exact tag + registry
# digest on every FROM — the digest is the enforcement, the tag the human
# reference). These are Docker Hardened Images (dhi.io, Apache-2.0, free
# for everyone as of 2025-12): minimal Debian-13-based, near-zero CVE
# stand-ins for the official rust images. `-dev` = build stage WITH shell
# and cargo. 1.95 matches the toolchain the workspace builds with.
FROM dhi.io/rust:1.95-dev@sha256:f6e61d660495bd925b8e76288b0c5c50c2f70a0d981181eba12c1bca3dff14d3 AS build
# No `ARG BIN` in this stage on purpose: the three shipped binaries are built
# together below, so core-api, worker and marula-core-cli all resolve to the
# SAME builder layer and `docker compose build` compiles the workspace once
# instead of three times. BIN only picks which binary the runtime stage keeps.
WORKDIR /src
# openssl-sys (reachable through the native-TLS stack on Linux) needs
# pkg-config and the OpenSSL headers at build time. The hardened DHI rust
# image ships neither, so the build failed at the first -sys crate. The
# runtime stage already carries libssl3 + ca-certificates, so only the build
# stage needs this. Installed before the source COPYs so a source change does
# not re-run it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# First-party extensions live under plugins/ (ADR 0013; moved there from a
# top-level connectors/ in Wave 47) and every connectors/* is a workspace
# member, so cargo needs the whole tree to resolve the graph.
COPY plugins ./plugins
# desktop is a workspace member; cargo needs every member manifest present
# to resolve the workspace graph even when building a different BIN.
COPY desktop/Cargo.toml /src/desktop/Cargo.toml
COPY desktop/build.rs /src/desktop/build.rs
COPY desktop/src /src/desktop/src
# installer is a workspace member too (root Cargo.toml). Without its manifest
# cargo stops at "failed to load manifest for workspace member .../installer"
# before it compiles anything, so a clean-context build could not start.
COPY installer/Cargo.toml /src/installer/Cargo.toml
COPY installer/build.rs /src/installer/build.rs
COPY installer/src /src/installer/src
# sqlx offline query cache (macros resolve without a database at build).
COPY .sqlx /src/.sqlx
# core-api includes two generated artifacts from packages/sdk at compile time:
# the OpenAPI pins (chat_runner) and the MCP catalog (mcp_catalog). Both must be
# present or the build fails on include_str!, so they are copied together.
COPY packages/sdk/openapi.json /src/packages/sdk/openapi.json
COPY packages/sdk/mcp-catalog.json /src/packages/sdk/mcp-catalog.json
# BuildKit cache mounts: the cargo registry and target dir persist across
# image builds on the same builder, so lockfile-only changes don't trigger
# a full re-download/recompile. The binary is copied out of the mount in
# the same RUN (cache mounts are not visible to later layers).
#
# The cache ids are builder-global: every build on a builder shares one target
# dir whatever branch it came from, and COPY keeps the host's file mtimes. Cargo
# judges freshness by mtime, so a checkout whose files are OLDER than the cached
# artifacts can be treated as up to date and link a stale object. This is the
# same hazard scripts/lane-target-guard.py documents for the shared host target
# dir; the previous path-keyed mount shared the same way, so this is not new,
# only now explicit. Escape hatch when it bites: `docker builder prune
# --filter id=marula-cargo-target`, or key the id on a hash of Cargo.lock
# (pass it as a build arg and interpolate it into the mount id).
#
# --locked: the shipped binary must match the committed Cargo.lock; without it
# cargo may rewrite the lock inside the build and ship something nobody
# reviewed. All three packages go in ONE invocation so the shared dependency
# graph compiles once. The CLI's executable is `marula`; it is stored as
# /out/marula-core-cli so BIN names the package, as it always has.
RUN --mount=type=cache,id=marula-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=marula-cargo-target,target=/src/target,sharing=locked \
    cargo build --release --locked --package core-api --package worker --package marula-core-cli \
    && mkdir -p /out \
    && cp target/release/core-api /out/core-api \
    && cp target/release/worker /out/worker \
    && cp target/release/marula /out/marula-core-cli

# Minimal hardened runtime: dhi.io/debian-base (Debian 13 trixie, ~80 MB)
# ships ca-certificates for outbound TLS and its own `nonroot` user
# (uid/gid 65532, passwd-verified — k8s runAsNonRoot-verifiable). No
# useradd needed; no shell tools beyond the base (healthchecks use the
# binaries' /healthz over the network, or pg_isready/valkey-cli in their
# own images). The services bind >1024 ports only.
FROM dhi.io/debian-base:trixie@sha256:b6c199b4653673cb7863db456a5aeb14438674106216b99cf8e9752cd0156046
ARG BIN=core-api
# Normalized fixed name: ARGs are baked into shell-form ENTRYPOINT strings
# at build time but are NOT available as runtime env — exec-form with the
# literal path is the reliable contract (compose passes BIN via build args).
COPY --from=build /out/${BIN} /usr/local/bin/marula
# The image's own nonroot user (numeric, runAsNonRoot-verifiable).
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/marula"]
CMD []
