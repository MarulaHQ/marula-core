# Meridian web app image (apps/web).
#
# Purpose: production Next.js build of the browser client, served from the
# standalone output — no dev dependencies ship in the runtime layer.
# NEXT_PUBLIC_API_URL is baked at BUILD time and must be the URL the user's
# BROWSER uses to reach core-api (not an internal service name), because the
# app calls the API directly from the client.
#
# Non-purpose: no SSR data fetching beyond what apps/web implements; no
# static asset CDN — this targets local/dev/demo stacks.
#
# Build: docker build -f deploy/Dockerfile.web \
#          --build-arg NEXT_PUBLIC_API_URL=http://localhost:8080 .
# syntax=docker/dockerfile:1

FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
# Workspace manifests first so dependency install caches independently of source.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/ui/package.json packages/ui/
COPY packages/layout/package.json packages/layout/
COPY packages/sdk/package.json packages/sdk/
RUN pnpm --filter @meridian/web... install --frozen-lockfile

COPY . .
WORKDIR /repo/apps/web
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN pnpm --filter @meridian/web build

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
