# Marula web app image (apps/web).
#
# Purpose: production Next.js build of the browser client, served from the
# standalone output — no dev dependencies ship in the runtime layer.
# NEXT_PUBLIC_API_URL is baked at BUILD time and must be the URL the user's
# BROWSER uses to reach core-api (not an internal service name), because the
# app calls the API directly from the client.
#
# Non-purpose: no SSR data fetching beyond what apps/web implements; no
# static asset CDN — this targets local/dev/demo stacks.
#
# Build: docker build -f deploy/Dockerfile.web \
#          --build-arg NEXT_PUBLIC_API_URL=http://localhost:8080 .
# syntax=docker/dockerfile:1

# Docker Hardened Images (dhi.io, Apache-2.0, free for everyone since
# 2025-12): Debian-13-based node, digest-pinned (exact tag + registry
# digest on every FROM — the digest enforces, the tag is readable).
# `-dev` build stage carries the shell + package tooling; the runtime
# image is stripped (no shell — exec-form CMD only). Node 22.23.4 still
# begs for corepack enable pnpm at build. The digest moved on 2026-10-20
# for the 22.23.4 security release; both stages move together so build and
# run never disagree about the runtime.
FROM dhi.io/node:22-dev@sha256:76403e2f1692d94caaf2bc2fafdac8ec97fd0133cc3c77477e97974de22cc778 AS build
WORKDIR /repo
RUN corepack enable pnpm
# Workspace manifests first so dependency install caches independently of source.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/ui/package.json packages/ui/
COPY packages/layout/package.json packages/layout/
COPY packages/sdk/package.json packages/sdk/
RUN pnpm --filter @marula-core/web... install --frozen-lockfile

COPY . .
WORKDIR /repo/apps/web
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
COPY deploy/web-standalone-remap.cjs /remap.cjs
RUN pnpm --filter @marula-core/web build && node /remap.cjs

FROM dhi.io/node:22@sha256:7390ab11306fa78b4e3f47acaa08bddcaaabac850a01996d153a2e805360a741 AS run
WORKDIR /repo/apps/web/.next/standalone
# Tighten the runtime: dedicated non-root uid/gid and no privilege
# escalation. The image USER is 1000:1000; compose/k8s restate it so the
# deployment config is the visible source of truth.
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
# The standalone tree's node_modules entries are pnpm symlinks whose
# relative targets resolve only against the ORIGINAL /repo workspace shape
# (same trick the desktop bundler uses in scripts/build-desktop.sh). Keep
# the run stage rooted exactly there instead of dereferencing — a flat
# re-location breaks every ../../../node_modules/.pnpm link.
COPY --from=build /repo/node_modules /repo/node_modules
COPY --from=build /repo/apps/web/.next/standalone /repo/apps/web/.next/standalone
COPY --from=build /repo/apps/web/.next/static /repo/apps/web/.next/static
RUN chown -R node:node /repo/node_modules /repo/apps/web/.next
# The image's own node user: uid/gid 1000 (numeric, passwd-verified —
# runAsNonRoot-verifiable).
USER 1000:1000
EXPOSE 3000
CMD ["node", "server.js"]
