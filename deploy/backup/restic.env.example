# restic (object-store snapshots) env template.
#
#   cp deploy/backup/restic.env.example deploy/backup/restic.env
#   chmod 600 deploy/backup/restic.env
#
# The copy is gitignored and must never be committed: it names the repository
# and the passphrase that decrypts it. This template ships without the
# credential values; backupd.sh fails the restic layer loudly when the
# repository or the passphrase is missing.
RESTIC_REPOSITORY=s3:http://garage:3900/marula-backups
RESTIC_PASSWORD_FILE=/opt/backup/restic.pass
# Generate the passphrase once, into a file that is never committed:
#   dd if=/dev/urandom count=64 bs=8 2>/dev/null | base64 | tr -d '\n' > restic.pass
# RESTIC_PASSWORD= is the alternative to the file, for a secret mount.

# Destination credentials — REQUIRED for an s3: repository, and deliberately
# absent here. Uncomment both in the copy you create:
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=

# What gets snapshotted (see backupd.sh): the LocalFsStore objects dir when
# OBJECT_STORE is not s3, and/or the pg_dump staging dir. Snapshot cadence via
# BACKUP_CRON. Retention via `restic forget --keep-daily 7 --keep-weekly 4`.
BACKUP_SOURCES=/data/objects /pgdumps
