# WAL-G (Postgres PITR) env template.
#
#   cp deploy/backup/wal-g.env.example deploy/backup/wal-g.env
#   chmod 600 deploy/backup/wal-g.env
#
# The copy is gitignored and must never be committed: it holds the keys to
# every backup this deployment makes. This template ships without any
# credential value — supply them in your copy, from the compose environment,
# or from a secret mount, and backupd.sh fails the layer loudly (naming the
# variable) when one is missing.
#
# When WALG_S3_PREFIX (+ credentials) are set, backupd.sh runs
# `wal-g backup-push --verify` and `wal-verify integrity`, and the compose
# override `deploy/backup/compose.walg.example.yml` wires `archive_command` for
# continuous WAL shipping ≡ point-in-time recovery. Unset = nightly pg_dump only.

# ---- the database connection ------------------------------------------------
# These are libpq's names, the same ones pg_dump, psql and wal-g read. The
# runner exports its defaults under exactly these names; a private spelling
# (PG_USER, which this file never used) would split one pass across two
# different roles.
PGHOST=postgres
PGPORT=5432
PGUSER=marula
PGDATABASE=marula
# REQUIRED and deliberately absent. The bundled postgres image authenticates
# TCP connections with scram-sha-256, so a password (or a PGPASSFILE) is what
# makes the connection in the first place. Uncomment in the copy you create:
#   PGPASSWORD=
#   PGPASSFILE=/opt/backup/pgpass

# PGUSER must be able to do two things beyond connecting:
#   * read every table for pg_dump (GRANT pg_read_all_data, or ownership);
#   * open a REPLICATION connection — `wal-g backup-push` with no PGDATA
#     argument streams the base backup over the BASE_BACKUP protocol, which
#     Postgres only accepts from a role holding REPLICATION.
# The compose `marula` role is the cluster superuser, so it has both and needs
# nothing here. A dedicated backup role does:
#   CREATE ROLE marula_backup LOGIN PASSWORD '<generated>' REPLICATION;
#   GRANT CONNECT ON DATABASE marula TO marula_backup;
#   GRANT pg_read_all_data TO marula_backup;
# The replication connection also needs a pg_hba.conf line: initdb's generated
# file covers `host replication` only for loopback, so a backup container on
# another address is refused until the rule exists. As the server superuser:
#   echo 'host replication marula_backup all scram-sha-256' >> /var/lib/postgresql/data/pg_hba.conf
#   SELECT pg_reload_conf();
# See docs/site/reference/backup-restore.md § WAL-G specifics.

WALG_S3_PREFIX=s3://marula-backups/pg
WALG_S3_ENDPOINT=http://garage:3900
AWS_REGION=garage
WALG_COMPRESSION_METHOD=lz4

# Destination credentials — REQUIRED when WALG_S3_PREFIX is set, and
# deliberately absent here. Uncomment both in the copy you create:
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
# Alternatives backupd.sh accepts: AWS_SHARED_CREDENTIALS_FILE pointing at a
# readable credentials file, or WALG_USE_IAM_ROLE=1 on a cloud instance profile.

# Retention: after each backup-push, `wal-g delete retain FULL <n> --confirm`
# culls stale full backups. Without --confirm wal-g only LISTS them, which is
# how a destination fills up quietly — the runner always passes it.
#   WALG_RETAIN_FULL=4          # keep the newest 4 full backups; unset = no culling
#   WALG_RETENTION_DRY_RUN=1    # rehearse: list what would be deleted, delete nothing
WALG_RETAIN_FULL=4

# Page-checksum verification during backup-push needs the cluster to run with
# data_checksums on (PostgreSQL 18 initialises with it on; older clusters need
# initdb --data-checksums). backupd.sh logs a WARNING when it is off, because
# wal-g then skips the check instead of failing.
# WALG_SKIP_WAL_VERIFY=1 skips the nightly `wal-verify integrity` WAL listing.
