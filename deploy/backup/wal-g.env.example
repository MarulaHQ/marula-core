# WAL-G (Postgres PITR) env template — copy to a real env file, fill in, never commit secrets.
# When WALG_S3_PREFIX (+ credentials) are set, backupd.sh runs `wal-g backup-push`
# and the compose-override `deploy/backup/compose.walg.yml` wires `archive_command`
# for continuous WAL shipping ≡ point-in-time recovery. Unset = nightly pg_dump only.
PGHOST=postgres
PGPORT=5432
PGUSER=meridian
PGDATABASE=meridian

WALG_S3_PREFIX=s3://meridian-backups/pg
WALG_S3_ENDPOINT=http://garage:3900
AWS_REGION=garage
AWS_ACCESS_KEY_ID=meridian
AWS_SECRET_ACCESS_KEY=meridian-dev-garage
WALG_COMPRESSION_METHOD=lz4
# Retention: keep the last N full backups (wal-g delete retain FULL <n> weekly)
WALG_RETAIN_FULL=4
