# The dev marker, as a file.
#
# NOT loaded automatically. Compose reads `.env` on its own; this file
# reaches a stack only when a command names it:
#
#   docker compose -f deploy/docker-compose.yml --env-file deploy/dev.env up --build
#
# Every value below is published in this repository. They were the defaults
# inline in docker-compose.yml until Wave 56. The two seam tokens are the
# ones crates/core-api/src/config.rs names (DEV_INTERNAL_TOKEN and
# DEV_EMAIL_INTERNAL_TOKEN), so a dev API in the same shell still accepts a
# worker call. That is the
# whole point of the file: a laptop stack boots without ceremony, and the
# stack says out loud, at every boot, that it is running on keys anyone can
# read. The `dev-posture` service prints that warning; it keys off these
# values, so exporting them by hand warns the same way.
#
# Never pass this file to a host you do not own. A key in a public
# repository is a key that mints valid owner tokens, decrypts sealed rows,
# drives the worker seam, opens the database and drives the object store. An
# operator install generates its own:
#
#   export JWT_SECRET=$(openssl rand -hex 32)
#   export MARULA_SECRET_KEY=$(openssl rand -hex 32)
#   export MARULA_INTERNAL_TOKEN=$(openssl rand -hex 32)
#   export EMAIL_INTERNAL_TOKEN=$(openssl rand -hex 32)
#   export POSTGRES_PASSWORD=$(openssl rand -hex 32)   # fresh volume only
#   export MARULA_APP_PASSWORD=marula_app               # minted by migration 0114
#   export GARAGE_RPC_SECRET=$(openssl rand -hex 32)
#   export GLITCHTIP_SECRET_KEY=$(openssl rand -hex 32)

# What the marker means: /api/dev/* mounted, `seed-demo` allowed, and the
# binary's declared dev fallbacks on (ADR 0005).
MARULA_DEV_TOOLS=1

# Access/refresh token signing (HS256). 64 hex chars.
JWT_SECRET=5d1a2f0b3c4e5f60718293a4b5c6d7e8f9a0b1c2d3e4f5061728394a5b6c7d8e

# AES-256 at-rest key for sealed integration secrets. Must match on core-api
# and the worker or sealed webhook secrets become undecryptable. 64 hex.
MARULA_SECRET_KEY=6e6808490009ad97fe176b954f03a7eeeca54af4e10c384c7beb7ce43e0e7b21

# The worker-to-API machine seam: bearer half and email half.
MARULA_INTERNAL_TOKEN=dev-internal
EMAIL_INTERNAL_TOKEN=dev-email-internal

# Database credentials. POSTGRES_PASSWORD is the `marula` owner role's
# password, applied by initdb when the pgdata volume is first created — this
# value is what existing laptop volumes already have. MARULA_APP_PASSWORD must
# match the `marula_app` role, which migration 0114 creates with this literal;
# generating a random one here locks the API out.
POSTGRES_PASSWORD=marula
MARULA_APP_PASSWORD=marula_app

# The stage2 Garage RPC secret (32-byte hex) and GlitchTip's Django signing
# key. Published on purpose, like everything above: they make a laptop stack
# boot without ceremony, and the `dev-posture` container warns while they are
# in play.
GARAGE_RPC_SECRET=5ee1876f31b4a9ce1d2f6087c4e91ba9f0d8c3a25764b1e6892c40ada37f3102
GLITCHTIP_SECRET_KEY=glitchtip-dev-secret-change-me
