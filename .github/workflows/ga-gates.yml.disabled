# Wave 19 lane 4 `p19-ga-readiness` — GA readiness gates.
#
# TRIGGERS INTENTIONALLY DISABLED (file carries .disabled, mirror of ci.yml):
# main's workflow triggers were disabled repo-wide at commit f00cdb3; this
# lane lands the JOB DEFINITIONS only. Re-enabling is a user-approved
# landing-time decision recorded in design/qa-p19-ga-readiness/LANDING.md —
# rename to ci-ga-gates.yml (and ci.yml.disabled → ci.yml) in one commit.
#
# Jobs:
# 1. api-contract-tests — contract tests GENERATED from the committed
#    OpenAPI snapshot: every path+method in fixtures/openapi/v1/openapi.json
#    is probed against the REAL router (auth posture + versioning parity +
#    existence sentinels). Fails when the pinned contract and the mounted
#    surface diverge in either direction.
# 2. domain-coverage — domain-layer coverage ≥80% gate over crates/core-domain
#    (cargo-llvm-cov, lcov summary, line threshold).
# 3. u9-customization-crosscheck — policy §4.5: a migration that modifies a
#    construct referenced by customization rows must carry the in-transaction
#    transform (declared via `-- customization-transform:`).
# 4. perf-smoke — ticket-list p95 budget @50k (Wave 13 lane 8; moved here
#    so the GA gate set is one reviewable unit).

name: GA gates

# DISABLED — do not re-enable without the user-approved re-enable noted in
# the lane landing record:
# on:
#   pull_request:
#   push:
#     branches: [main]

concurrency:
  group: ga-gates-${{ github.ref }}
  cancel-in-progress: true

jobs:
  api-contract-tests:
    name: API contract tests (generated from the pinned OpenAPI — U1 parity + existence sentinels)
    runs-on: ubuntu-latest
    services:
      postgres:
        image: pgvector/pgvector:pg18
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: meridian_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
      redis:
        image: valkey/valkey:8
        ports: ["6379:6379"]
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_test
      REDIS_URL: redis://localhost:6379
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      # The generation source is the COMMITTED pin (never regenerated in CI):
      # api_versioning.rs reads packages/sdk/openapi.json and derives the
      # exhaustive probe set from it; golden_openapi.rs re-serves the live
      # spec from utoipa and compares byte-for-byte.
      - name: Contract probe set from the pinned OpenAPI (dual-mount parity + existence + drift)
        run: cargo test -q -p core-api --test api_versioning
      - name: Golden OpenAPI conformance (live spec == pinned golden)
        run: cargo test -q -p meridian-cli --test golden_openapi
        env:
          DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_test

  domain-coverage:
    name: Domain-layer coverage ≥80% (crates/core-domain)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: llvm-tools-preview
      - uses: Swatinem/rust-cache@v2
      - uses: taiki-e/install-action@cargo-llvm-cov
      - name: Measure domain-layer coverage
        run: |
          cargo llvm-cov -p core-domain --summary-only --fail-under-lines 80

  u9-customization-crosscheck:
    name: U9 — customization-aware migration cross-check (policy §4.5)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Migrations must carry in-transaction transforms for customization constructs
        run: ./scripts/check-customization-crosscheck.sh

  perf-smoke:
    name: Perf smoke — ticket-list p95 budget @50k tickets/org (Wave 13 lane 8)
    runs-on: ubuntu-latest
    services:
      postgres:
        image: pgvector/pgvector:pg18
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: meridian_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_test
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - run: cargo test -q -p perf-harness --test perf_smoke -- --nocapture
