# Release pipeline (the private build tracker U10b + Wave 38 p38-container-hardening).
#
# ─────────────────────────────────────────────────────────────────────────────
# STAYS DISABLED (`.disabled` suffix), by decision of Wave 52 lane
# `p52-ci-gates-restore`. The reason, in one line: a release moves artifacts to
# a remote and that is a publishing decision, which belongs to the maintainer —
# not a gate a lane may switch on.
#
# Concretely, enabling it would need: a `vX.Y.Z` tag this repository does not
# cut by automation, a push to GHCR with `packages: write` plus OIDC for the
# provenance attestations, and a decision about which registry and which release
# page the artifacts land on. The definition is complete and reviewed against
# p38 (every action SHA-pinned, digest manifest printed for the chart's
# `digestPinningEnforced` gate); the switch is a person's.
# ─────────────────────────────────────────────────────────────────────────────
# On a vX.Y.Z tag:
#   1. Build + push four images to GHCR, pinned by digest, with provenance
#      attestations (buildx) and SBOMs (syft), both uploaded as artifacts
#      AND attested into the registry.
#   2. Scan every built image with trivy and lint every Dockerfile with
#      hadolint — a HIGH/CRITICAL fixable vuln or a hadolint error fails
#      the release (p38 supply-chain gates).
#   3. Package the Helm chart and attach it to the release.
#   4. Print a digest manifest into the job summary (the values the chart's
#      digestPinningEnforced gate consumes).
# TS packages (packages/*) are versioned via Changesets on main
# (.github/workflows/changesets.yml), not on the tag.
#
# Non-purpose: no secret material in workflow files; no environment deploys.
#
# DEFINITIONS-ONLY: this file carries .disabled — its triggers are off.
# Re-enabling is a user-approved decision at landing time.

name: Release

on:
  push:
    tags: ["v*.*.*"]
  workflow_dispatch:
    inputs:
      tag:
        description: "Tag to release (e.g. v0.2.0)"
        required: true

# Job-level permissions only (p38 workflow least privilege): the top-level
# block is empty, each job gets the narrowest set it needs.
permissions: {}

env:
  REGISTRY: ghcr.io
  OWNER: ${{ github.repository_owner }}

jobs:
  images:
    name: Build, push, SBOM, provenance — ${{ matrix.image }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - image: marula-core-api
            dockerfile: deploy/Dockerfile.rust
            build_args: BIN=core-api
          - image: marula-worker
            dockerfile: deploy/Dockerfile.rust
            build_args: BIN=worker
          - image: marula-core-cli
            dockerfile: deploy/Dockerfile.rust
            build_args: BIN=marula-core-cli
          - image: marula-web
            dockerfile: deploy/Dockerfile.web
            build_args: ""
    steps:
      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v6

      - name: Resolve tag
        id: tag
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            TAG="${{ inputs.tag }}"
          else
            TAG="${GITHUB_REF_NAME}"
          fi
          echo "tag=${TAG}" >> "$GITHUB_OUTPUT"

      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1

      - name: Log in to GHCR
        uses: docker/login-action@783ae9cac559640a24c9212dfa6cd9e998252f9a # v4.6.0
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push (tag + provenance)
        id: build
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: .
          file: ${{ matrix.dockerfile }}
          push: true
          build-args: ${{ matrix.build_args }}
          tags: |
            ${{ env.REGISTRY }}/${{ env.OWNER }}/${{ matrix.image }}:${{ steps.tag.outputs.tag }}
          provenance: mode=max
          sbom: true

      - name: SBOM (syft)
        id: sbom
        uses: anchore/sbom-action@6b31fa7e2d592e47d95d2a5e0520a7352d47ead5 # v0.24.2
        with:
          image: ${{ env.REGISTRY }}/${{ env.OWNER }}/${{ matrix.image }}@${{ steps.build.outputs.digest }}
          format: spdx-json
          artifact-name: sbom-${{ matrix.image }}.spdx.json
          upload-artifact: false

      - name: Attest build provenance
        uses: actions/attest-build-provenance@9d57eef8c06cd9d6b433effeeb7a6a77b3ff94ad # v4.2.2
        with:
          subject-name: ${{ env.REGISTRY }}/${{ env.OWNER }}/${{ matrix.image }}
          subject-digest: ${{ steps.build.outputs.digest }}

      - name: Upload SBOM artifact
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: sbom-${{ matrix.image }}.spdx.json
          path: ${{ steps.sbom.outputs.artifact-name }}
          if-no-files-found: warn

      - name: Record digest
        run: echo "${{ matrix.image }}=${{ steps.build.outputs.digest }}" >> "$GITHUB_STEP_SUMMARY"

  scan:
    name: Trivy scan + hadolint — ${{ matrix.image }}
    runs-on: ubuntu-latest
    needs: images
    permissions:
      contents: read
      packages: read
    strategy:
      fail-fast: false
      matrix:
        include:
          - image: marula-core-api
            dockerfile: deploy/Dockerfile.rust
          - image: marula-worker
            dockerfile: deploy/Dockerfile.rust
          - image: marula-core-cli
            dockerfile: deploy/Dockerfile.rust
          - image: marula-web
            dockerfile: deploy/Dockerfile.web
    steps:
      - name: Log in to GHCR (pull-only)
        uses: docker/login-action@783ae9cac559640a24c9212dfa6cd9e998252f9a # v4.6.0
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # db: false keeps the scan self-contained (no vuln DB updates) — the
      # pinned trivy-action image ships with a recent DB snapshot at build
      # time of the action itself.
      - name: Trivy image scan (fail on HIGH/CRITICAL fixable)
        uses: aquasecurity/trivy-action@d2a0b60797ff03db6132bd4e2b293f9b37081297 # v0.36.0
        with:
          image-ref: ${{ env.REGISTRY }}/${{ env.OWNER }}/${{ matrix.image }}
          scan-type: image
          ignore-unfixed: true
          severity: HIGH,CRITICAL
          exit-code: "1"

      - name: Hadolint Dockerfile
        uses: hadolint/hadolint-action@06be81baf89a55ffd0e24b8f04a4185738dd3387 # v3.5.0
        with:
          dockerfile: ${{ matrix.dockerfile }}
          failure-threshold: error

  chart:
    name: Package Helm chart
    runs-on: ubuntu-latest
    needs: images
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v6
      - uses: azure/setup-helm@b85984b901f10908cd32321c0c203c7186607506 # v5.0.1
        with:
          version: v3.14.4
      - name: Lint + package
        run: |
          helm lint deploy/helm/marula
          helm package deploy/helm/marula -d dist/
      - name: Attach chart to release
        uses: softprops/action-gh-release@a4f117a9dd5572319a486154ec1147aebabd285c # v3.0.3
        with:
          files: dist/*.tgz
