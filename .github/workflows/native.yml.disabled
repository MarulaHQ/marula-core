name: Native (Expo / React Native)

# ─────────────────────────────────────────────────────────────────────────────
# PARKED (`.disabled` suffix), by user direction 2026-10-21: "keep any CI that
# will take a lot of minutes disabled for now — keep it light." This is the
# scheduled set, and it is the heavy one: perf smoke and the load budget build
# release binaries, the 100k scale run seeds a large tenant, e2e boots the stack
# for both themes, and the security and scanner legs pull containers and a
# signature database. Rename the file back to enable it; nothing else in it
# needs to change. The per-push and pull-request gates in `ci.yml` are the ones
# that decide whether a change may merge, and they stay on.
# ─────────────────────────────────────────────────────────────────────────────


# Wave 33 lane 1 foundation wiring. Two lanes of checks:
#
#   native-checks (ubuntu)  — typecheck, lint, unit tests, web export.
#     Cheap, deterministic, and the only lane that belongs on every merge.
#
#   maestro-ios (macOS)     — boots the e2e stack, builds the iOS app, runs
#     the Maestro flows on a simulator. macOS runner minutes stay OFF the
#     per-merge path by design: this job runs at lane close, nightly, and
#     on manual dispatch only.
#
# Nightly on a schedule, plus manual dispatch. `native-checks` is the cheap
# lane (typecheck, lint, unit tests, web export on ubuntu); `maestro-ios` keeps
# macOS runner minutes off the per-merge path by design. The Wave 52 split put
# the native set on the nightly side as a whole: a native regression is real,
# but it is not the thing a web or backend change should wait for.

on:
  workflow_dispatch: {}
  schedule:
    - cron: "45 5 * * *" # nightly, after the perf sweep

permissions:
  contents: read

jobs:
  native-checks:
    name: Native checks (ubuntu)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 9
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - name: Install
        run: pnpm install --frozen-lockfile
      - name: Typecheck
        run: pnpm --filter @marula-core/native typecheck
      - name: Lint
        run: pnpm --filter @marula-core/native lint
      - name: Unit tests (offline queue, cache, live stream, sync engine)
        run: pnpm --filter @marula-core/native test
      - name: Expo web export (bundle check — fast-iteration surface)
        run: pnpm --filter @marula-core/native export:web
      - name: Upload web export
        uses: actions/upload-artifact@v4
        with:
          name: native-web-export
          path: native/dist
          retention-days: 7

  maestro-ios:
    name: Maestro simulator matrix (macOS)
    runs-on: macos-14
    timeout-minutes: 90
    # Lane close / nightly only — never the per-merge path.
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 9
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - name: Preflight — Docker + Xcode required
        run: |
          command -v docker >/dev/null || { echo "::error::Docker is required to boot the e2e stack on this runner"; exit 1; }
          xcodebuild -version
      - name: Install workspace
        run: pnpm install --frozen-lockfile
      - name: Boot the e2e stack (per-run ports + reseed)
        run: bash scripts/e2e-stack.sh up
      - name: Export stack env for the app build
        run: |
          set -a
          . e2e/.e2e-stack.env
          set +a
          # The stack env names the API URL (E2E_API_URL); the app reads
          # EXPO_PUBLIC_* at bundle time. The live leg is core-api's SSE
          # stream at /api/events/stream. The app trims a trailing slash
          # itself, so either form is safe.
          echo "EXPO_PUBLIC_API_URL=${E2E_API_URL}" >> "$GITHUB_ENV"
          echo "EXPO_PUBLIC_SSE_URL=${E2E_API_URL%/}/api/events/stream" >> "$GITHUB_ENV"
      - name: Boot a simulator
        run: |
          DEVICE=$(xcrun simctl list devices available | grep -m1 'iPhone' | sed -E 's/.*\(([0-9A-F-]+)\).*/\1/')
          echo "SIMULATOR_UDID=$DEVICE" >> "$GITHUB_ENV"
          xcrun simctl boot "$DEVICE" || true
      - name: Build + install the app (Release, New Architecture)
        run: pnpm --filter @marula-core/native exec expo run:ios --configuration Release --device "$SIMULATOR_UDID" --no-bundler
        env:
          CI: "1"
          # The dev-menu offline toggle and scan injector are off in release
          # builds; this verification build opts in so Maestro can exercise
          # the deterministic offline path without OS network tricks.
          EXPO_PUBLIC_ENABLE_DEV_TOOLS: "1"
      - name: Install Maestro
        run: curl -Ls "https://get.maestro.mobile.dev" | bash
      - name: Run Maestro flows
        run: |
          export PATH="$PATH:$HOME/.maestro/bin"
          maestro test native/e2e/flows || true
      - name: Collect simulator captures
        if: always()
        run: |
          mkdir -p native/artifacts
          xcrun simctl io "$SIMULATOR_UDID" screenshot native/artifacts/failure.png || true
      - name: Upload Maestro artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: maestro-artifacts
          path: native/artifacts
          retention-days: 14
      - name: Tear down the stack
        if: always()
        run: bash scripts/e2e-stack.sh down "$(grep -m1 RUN_ID e2e/.e2e-stack.env | cut -d= -f2)" || true
