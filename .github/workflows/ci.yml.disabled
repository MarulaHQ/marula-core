name: CI

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  rust:
    name: Rust — fmt · clippy · test
    runs-on: ubuntu-latest
    services:
      postgres:
        # pgvector/pgvector:pg18 — same image as prod; core-db integration
        # tests (crates/core-db/tests) attach to THIS service container via
        # DATABASE_URL below, so no Docker-in-Docker/testcontainers needed.
        image: pgvector/pgvector:pg18
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: meridian_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
      redis:
        image: valkey/valkey:8
        ports: ["6379:6379"]
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_test
      REDIS_URL: redis://localhost:6379
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@v2
      - run: cargo fmt --all -- --check
      - run: cargo clippy --workspace --all-targets -- -D warnings
      - run: cargo test --workspace

  frontend:
    name: Web — lint · types · test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 9
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm turbo run lint typecheck test

  migrations:
    name: Migration safety (no destructive change without --breaking)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: ./scripts/check-migrations.sh

  openapi-pins:
    name: OpenAPI pin format (compact minified snapshots, byte-identical pair — DX12)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: ./scripts/check-openapi-pins.sh

  rls-pool-reads:
    name: RLS pool-read gate (no new unscoped &state.pool reads in routes)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      # Wave 13 lane 3 (TASKLIST RLS-scope audit): every tenant read must
      # ride an org-bound tx (set_org_and_user); allowlisted pre-auth
      # SECURITY DEFINER bridges + dev-tools surfaces are the only raw-pool
      # reads. New pool-reads fail review here.
      - run: ./scripts/check-rls-pool-reads.sh

  rls-coverage:
    name: RLS coverage (every user-data table has a policy)
    runs-on: ubuntu-latest
    services:
      postgres:
        # pgvector/pgvector:pg18 — prod parity. The gate runs the same
        # assert_rls_coverage check core-api performs at boot, as a
        # standalone test target (fails CI independently of server start).
        image: pgvector/pgvector:pg18
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: meridian_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_test
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - run: cargo test -p core-db --test rls_coverage

  brand-distinctness:
    name: Brand distinctness — Workbench tokens only
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Scan UI source for off-palette brand hexes
        run: |
          if grep -riE '#(0A8C6A|2DD4BF|FBF8F3|E8E6DF|D64B0A|F4F5F7|E8EBEF|101216|171A1F|12161C)' \
              --include='*.css' --include='*.scss' --include='*.tsx' --include='*.ts' \
              apps packages \
              --exclude-dir=node_modules; then
            echo "::error::Off-palette brand colors found in UI code — use Tangerine tokens from packages/ui"
            exit 1
          fi
          echo "Clean — all UI colors on the Tangerine token set."

  deprecation-clock:
    name: Deprecation clock (removals honor removal_target — policy §8/U4)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      # Gate + self-tests: fails when deprecations.json carries a construct
      # past its removal_target, or when a construct is gone before it.
      - run: cargo test -p core-events --test deprecation_clock

  api-conformance:
    name: Golden OpenAPI conformance (U8 — live spec vs pinned golden)
    runs-on: ubuntu-latest
    services:
      postgres:
        image: pgvector/pgvector:pg18
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: meridian_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
      redis:
        image: valkey/valkey:8
        ports: ["6379:6379"]
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_test
      REDIS_URL: redis://localhost:6379
      JWT_SECRET: ci-conformance-secret
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Migrate schema
        run: cargo run -q -p meridian-cli -- migrate
      - name: Boot core-api
        run: |
          cargo run -q -p core-api &
          for i in $(seq 1 60); do
            curl -fsS http://localhost:8080/healthz >/dev/null 2>&1 && break
            sleep 1
          done
          curl -fsS http://localhost:8080/healthz
      - name: Live spec must equal the pinned golden
        run: MERIDIAN_API_BASE_URL=http://localhost:8080 cargo test -q -p meridian-cli --test golden_openapi

  e2e:
    name: E2E — Playwright, 10 core flows × light+dark (Wave 14 lane 8)
    runs-on: ubuntu-latest
    services:
      postgres:
        # pgvector/pgvector:pg18 — prod parity; the demo seed writes into
        # THIS service DB, so the suite runs against real seeded data.
        image: pgvector/pgvector:pg18
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: meridian_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
      redis:
        image: valkey/valkey:8
        ports: ["6379:6379"]
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_test
      REDIS_URL: redis://localhost:6379
      E2E_API_URL: http://localhost:8080
      E2E_WEB_URL: http://localhost:3000
      # Flake budget (e2e/helpers/budget.ts): the global teardown fails the
      # gate when more tests than the budget needed a retry. A failure here
      # is investigated, never shrugged off.
      CI: "true"
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - uses: pnpm/action-setup@v4
        with:
          version: 9
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - name: Install JS deps + Playwright browsers
        run: |
          pnpm install --frozen-lockfile
          pnpm exec playwright install --with-deps chromium
      - name: Boot the seeded demo stack (migrate → seed-demo → core-api)
        run: ./scripts/e2e-stack.sh
      - name: Build the web app (API URL inlined at build time)
        run: |
          NEXT_PUBLIC_API_URL=http://localhost:8080 pnpm --filter @meridian/web build
      - name: Run the 10 core flows in both themes
        run: pnpm exec playwright test --config=e2e/playwright.config.ts
      - name: Flake-gate verdict (budget from e2e/helpers/budget.ts)
        if: always()
        run: node e2e/flake-gate.ts
      - name: Upload failure artifacts
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: e2e-artifacts
          path: |
            e2e/test-results/
            playwright-report/
          retention-days: 7

  perf-smoke:
    name: Perf smoke — ticket-list p95 budget @50k tickets/org (Wave 13 lane 8)
    runs-on: ubuntu-latest
    services:
      postgres:
        # pgvector/pgvector:pg18 — prod parity; the smoke measures the real
        # RLS-scoped ticket-list query path against this service DB.
        image: pgvector/pgvector:pg18
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: meridian_perf
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_perf
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      # scripts/perf-smoke.sh sets MERIDIAN_PERF_SMOKE=1 (the test is
      # env-gated so the plain `cargo test --workspace` sweep skips it).
      # Budgets: 150ms p95 on the primary mixes; deep-page (OFFSET 40k)
      # rides a 400ms regression tripwire — see docs/perf.md.
      - run: ./scripts/perf-smoke.sh

  upgrade-matrix:
    name: N−2 upgrade matrix (U7 — restore fixture → migrate to HEAD)
    runs-on: ubuntu-latest
    services:
      postgres:
        # pgvector/pgvector:pg18 — prod parity with the fixture capture.
        image: pgvector/pgvector:pg18
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: meridian_upgrade
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s --health-timeout 5s --health-retries 5
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/meridian_upgrade
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      # One leg per captured fixture (v0.2.0 onward). Restoring replays the
      # full schema + data + migration state of the tagged release; migrating
      # to HEAD proves the forward path on production-like data.
      - name: Restore v0.2.0 fixture
        run: |
          gunzip -c fixtures/upgrades/v0.2.0.seed.sql.gz \
            | psql postgres://postgres:postgres@localhost:5432/meridian_upgrade -v ON_ERROR_STOP=1 -q
      - name: Migrate fixture to HEAD
        run: cargo run -q -p meridian-cli -- migrate
      - name: Fixture org survives the migration
        run: |
          psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -tAc \
            "SELECT count(*) FROM custom_field_defs WHERE org_id = '00000000-0000-4000-8000-000000000001'" \
            | grep -q '^7$'
          psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -c \
            "SELECT 1 FROM board_statuses WHERE org_id = '00000000-0000-4000-8000-000000000001' AND category = 'closed'"
      - name: Upgrade preflight consumes the captured manifest
        run: |
          cargo build -q -p meridian-cli
          ./target/debug/meridian upgrade --check \
            --manifest fixtures/upgrades/v0.2.0.manifest.json
