    "kv_namespace_bytes": 64,
    "kv_key_bytes": 512,
    "kv_value_bytes": 1048576,
    "kv_list_page": 500,
    "http_response_bytes": 2097152,
    "http_timeout_ms": 5000,
    "http_redirects": 0,
    "fuel": 200000000,
    "wall_clock_ms": 250,
    "epoch_tick_ms": 50,
    "instance_memory_bytes": 67108864,
