    { "code": 8, "reason": "plugin_egress_scheme_denied" },
    { "code": 9, "reason": "plugin_egress_response_too_large" },
    { "code": 10, "reason": "plugin_event_type_not_declared" },
    { "code": 11, "reason": "plugin_query_unknown" },
    { "code": 12, "reason": "plugin_worker_failed" },
    { "code": 13, "reason": "plugin_not_implemented" },
    { "code": 14, "reason": "plugin_unknown_host_fn" },
    { "code": 15, "reason": "plugin_abi_frame_invalid" },
    { "code": 16, "reason": "plugin_input_too_large" },
    { "code": 17, "reason": "plugin_output_too_large" }
  ]
}
