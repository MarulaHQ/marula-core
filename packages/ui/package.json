{
  "name": "@marula-core/ui",
  "version": "0.3.3",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./theme-tokens": "./src/theme-tokens.ts",
    "./theme-bootstrap": "./src/theme-bootstrap.ts",
    "./kit": "./src/kit/index.ts",
    "./theme.css": "./src/theme.css",
    "./kit-tokens.css": "./src/tokens-kit.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens": "node tokens/generate.mjs",
    "tokens:check": "node tokens/generate.mjs --check",
    "build": "tsc -p tsconfig.build.json && cp src/*.css dist/",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
