{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marula",
  "version": "0.3.2",
  "identifier": "org.marula.desktop",
  "build": {
    "frontendDist": "./connect"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
    "category": "Business",
    "copyright": "AGPL-3.0 — Marula contributors",
    "shortDescription": "The PSA you own",
    "longDescription": "Open-source PSA for IT teams and MSPs: tickets, timers, dispatch, and a client portal on your own Postgres. This desktop build embeds Postgres and core-api in one app (ADR 0005).",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://updates.getmarula.com/desktop/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENEYzNjA4NjQ5RThFRTEKUldUaGpwNWtDRFpQalU0VjAxZ1FTeE9MOGVPOXYyRkphbmdTVWpLWEovNkNxRFlXNEc4ZXlibXIK"
    }
  }
}
