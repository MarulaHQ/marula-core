# Editor defaults. Deliberately minimal: this file agrees with what the formatters
# already produce, so it does not fight rustfmt, prettier or eslint.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown; never strip them.
trim_trailing_whitespace = false
