{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id AS ticket_id, t.client_id, c.id AS line_id, c.description,\n                  round(c.quantity * c.unit_cost_minor)::bigint AS amount_minor, c.currency\n           FROM ticket_cost_lines c JOIN tickets t ON t.org_id = c.org_id AND t.id = c.ticket_id\n           WHERE c.org_id = $1 AND c.billable AND c.invoice_line_id IS NULL",
