  "query": "UPDATE webhooks SET\n               url = COALESCE($3, url),\n               event_types = COALESCE($4, event_types),\n               enabled = COALESCE($5, enabled),\n               updated_at = now()\n           WHERE id = $1 AND org_id = $2\n           RETURNING id, org_id, url, secret_encrypted, event_types, enabled,\n                     created_by, created_at",
