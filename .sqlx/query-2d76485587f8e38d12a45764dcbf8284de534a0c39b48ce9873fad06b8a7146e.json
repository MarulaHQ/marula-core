  "query": "SELECT d.entity, v.entity_id, v.field_id, v.value\n         FROM custom_field_values v\n         JOIN custom_field_defs d ON d.id = v.field_id AND d.org_id = v.org_id\n         WHERE v.org_id = $1\n         ORDER BY d.entity, v.entity_id, v.field_id",
