{
  "db_name": "PostgreSQL",
  "query": "SELECT id, org_id, client_id, number, name, contract_type, status, currency,\n                  effective_from, effective_until, billing_frequency, billing_anchor,\n                  amount_minor, hourly_rate_minor, included_minutes, overage_rate_minor,\n                  notes, created_at, updated_at\n           FROM contracts\n           WHERE org_id = $1\n             AND status <> $2\n             AND effective_from <= $4\n             AND (effective_until IS NULL OR effective_until >= $3)\n           ORDER BY number",
