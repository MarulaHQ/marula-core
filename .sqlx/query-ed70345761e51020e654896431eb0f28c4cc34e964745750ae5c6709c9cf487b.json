{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.org_id, r.name, r.builtin, r.permissions, r.is_system\n           FROM roles r\n           JOIN user_roles ur ON ur.role_id = r.id\n           WHERE ur.user_id = $1 AND r.org_id = $2\n           ORDER BY r.name",
