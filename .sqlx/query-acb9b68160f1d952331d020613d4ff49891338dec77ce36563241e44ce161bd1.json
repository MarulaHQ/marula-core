{
  "db_name": "PostgreSQL",
  "query": "SELECT s.entity_kind, s.entity_id, s.parent_id, s.title,\n                  left(s.body, 512) AS body_excerpt, s.indexed_at\n           FROM search_index s\n           JOIN unnest($2::text[], $3::uuid[]) AS k(kind, id)\n             ON s.entity_kind = k.kind AND s.entity_id = k.id\n           WHERE s.org_id = $1",
